---
interface Props {
    title?: string;
    description?: string;
}

const { title = "Reporter - Blog", description = "This is meta description" } =
    Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en-us" class="scroll-smooth">
    <head>
        <!-- Google tag (gtag.js) -->
        <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-PF8LHQLYDZ"
        ></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                dataLayer.push(arguments);
            }
            gtag("js", new Date());

            gtag("config", "G-PF8LHQLYDZ");
        </script>
        <meta charset="utf-8" />
        <title>{title}</title>
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, maximum-scale=5"
        />
        <meta name="description" content={description} />
        <meta name="author" content="Oleg Ushakov" />
        <link
            rel="shortcut icon"
            href={`${base}images/favicon.png`}
            type="image/x-icon"
        />
        <link
            rel="icon"
            href={`${base}images/favicon.png`}
            type="image/x-icon"
        />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
            rel="stylesheet"
        />
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        />

        <script is:inline src="https://cdn.tailwindcss.com"></script>
        <script is:inline>
            tailwind.config = {
                theme: {
                    extend: {
                        fontFamily: {
                            sans: ["Roboto", "sans-serif"],
                        },
                        colors: {
                            primary: "#0d9488",
                            "primary-dark": "#0f766e",
                            muted: "#71717a",
                            sidebar: "#f4f4f5",
                        },
                    },
                },
            };
        </script>
        <script
            is:inline
            defer
            src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"
        ></script>

        <link rel="stylesheet" href={`${base}css/style.css`} />
    </head>
    <body class="bg-gray-50 text-gray-800 antialiased">
        <header class="bg-white shadow-sm sticky top-0 z-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <nav class="flex items-center justify-between h-16">
                    <a
                        class="flex-shrink-0 flex items-center gap-1.5"
                        href={`${base}`}
                    >
                        <i class="fa-solid fa-star text-yellow-400"></i>
                        <span class="text-xl font-bold text-gray-900">Blog</span
                        >
                    </a>

                    <div class="hidden md:flex items-center gap-6">
                        <a
                            class="text-gray-700 hover:text-primary font-medium transition-colors text-primary"
                            href={`${base}`}>Home</a
                        >
                        <a
                            class="text-gray-700 hover:text-primary font-medium transition-colors"
                            href={`${base}projects`}>Projects</a
                        >
                        <a
                            class="text-gray-700 hover:text-primary font-medium transition-colors"
                            href={`${base}blogs`}>Blogs</a
                        >

                        <div class="relative" x-data="{ searchOpen: false }">
                            <button
                                @click="searchOpen = !searchOpen"
                                aria-label="Search"
                                class="p-2 text-gray-500 hover:text-primary transition-colors"
                            >
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </button>
                            <div
                                x-show="searchOpen"
                                @click.outside="searchOpen = false"
                                class="absolute right-0 top-full mt-2 w-80 bg-white border border-gray-200 shadow-lg rounded-lg p-3 z-50"
                            >
                                <form
                                    action="#!"
                                    class="flex items-center relative"
                                >
                                    <input
                                        id="search-query"
                                        name="s"
                                        type="search"
                                        placeholder="Search..."
                                        class="w-full pl-10 pr-4 py-2 text-sm border border-gray-200 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
                                    />
                                    <i
                                        class="fa-solid fa-magnifying-glass absolute left-3 text-gray-400 pointer-events-none"
                                    ></i>
                                </form>
                            </div>
                        </div>
                    </div>

                    <button
                        id="mobile-menu-btn"
                        aria-label="Toggle menu"
                        class="md:hidden p-2 text-gray-700 hover:text-primary"
                        @click="mobileOpen = !mobileOpen"
                    >
                        <i class="fa-solid fa-bars text-xl"></i>
                    </button>
                </nav>

                <div
                    x-show="mobileOpen"
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0 -translate-y-2"
                    x-transition:enter-end="opacity-100 translate-y-0"
                    x-transition:leave="transition ease-in duration-150"
                    x-transition:leave-start="opacity-100 translate-y-0"
                    x-transition:leave-end="opacity-0 -translate-y-2"
                    class="md:hidden pb-4 border-t border-gray-100 mt-2 pt-4"
                >
                    <div class="flex flex-col space-y-3">
                        <a
                            class="text-gray-700 hover:text-primary font-medium py-2 text-primary"
                            href={`${base}`}>Home</a
                        >
                        <a
                            class="text-gray-700 hover:text-primary font-medium py-2"
                            href={`${base}projects`}>Projects</a
                        >
                        <a
                            class="text-gray-700 hover:text-primary font-medium py-2"
                            href={`${base}blogs`}>Blogs</a
                        >
                    </div>
                </div>
            </div>
        </header>

        <main>
            <slot />
        </main>

        <footer class="border-t border-gray-200 mt-16">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
                <p class="text-center text-sm text-gray-500">
                    Copyright © 2026 Oleg Ushakov<span>
                        <a
                            href="https://github.com/OlegUshakov-pl"
                            class="ml-2 text-blue-500">GitHub</a
                        ></span>
                </p>
            </div>
        </footer>
    </body>
</html>
