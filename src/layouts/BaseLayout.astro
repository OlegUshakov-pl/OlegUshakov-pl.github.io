---
interface Props {
    title?: string;
    description?: string;
}

const { title = "Reporter - Blog", description = "This is meta description" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en-us">
    <head>
        <meta charset="utf-8" />
        <title>{title}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
        <meta name="description" content={description} />
        <meta name="author" content="Themefisher" />
        <link rel="shortcut icon" href={`${base}images/favicon.png`} type="image/x-icon" />
        <link rel="icon" href={`${base}images/favicon.png`} type="image/x-icon" />

        <meta name="theme-name" content="reporter" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
            rel="stylesheet"
        />
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

        <script is:inline src="https://cdn.tailwindcss.com"></script>
        <script is:inline>
            tailwind.config = {
                theme: {
                    extend: {
                        fontFamily: {
                            sans: ['Roboto', 'sans-serif'],
                        },
                        colors: {
                            primary: '#13AE6F',
                            dark: '#131313',
                        },
                    },
                },
            }
        </script>
        <script is:inline defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

        <link rel="stylesheet" href={`${base}css/style.css`} />

    </head>
    <body class="font-sans text-gray-700 bg-white leading-relaxed antialiased">
        <header>
            <div class="max-w-6xl mx-auto px-4 sm:px-6">
                <nav class="flex items-center justify-between py-6" x-data="{ mobileOpen: false }">
                    <a class="order-1" href={`${base}`}>
                        <img
                            loading="prelaod"
                            decoding="async"
                            class="h-auto"
                            src={`${base}images/logo.png`}
                            alt="Reporter Hugo"
                        />
                    </a>

                    <div class="order-3 ml-4 lg:hidden">
                        <button
                            aria-label="navbar toggler"
                            class="text-2xl"
                            @click="mobileOpen = !mobileOpen"
                        >
                            <span x-show="!mobileOpen"><i class="fa-solid fa-bars"></i></span>
                            <span x-show="mobileOpen"><i class="fa-solid fa-xmark"></i></span>
                        </button>
                    </div>

                    <div
                        class="hidden lg:flex lg:items-center lg:order-2 lg:ml-auto"
                    >
                        <ul class="flex items-center gap-6">
                            <li>
                                <a class="text-sm font-medium capitalize hover:text-primary transition" href={`${base}`}>Home</a>
                            </li>
                            <li>
                                <a class="text-sm font-medium capitalize hover:text-primary transition" href={`${base}notes`}>Blogs</a>
                            </li>
                            <li>
                                <a class="text-sm font-medium capitalize hover:text-primary transition" href={`${base}projects`}>Projects</a>
                            </li>
                            <li class="relative" x-data="{ searchOpen: false }">
                                <button
                                    @click="searchOpen = !searchOpen"
                                    class="text-sm font-medium hover:text-primary transition"
                                >
                                    <i class="fa-solid fa-magnifying-glass"></i>
                                </button>
                                <div
                                    x-show="searchOpen"
                                    @click.outside="searchOpen = false"
                                    x-transition:enter="transition ease-out duration-200"
                                    x-transition:enter-start="opacity-0 translate-y-1"
                                    x-transition:enter-end="opacity-100 translate-y-0"
                                    x-transition:leave="transition ease-in duration-150"
                                    x-transition:leave-start="opacity-100 translate-y-0"
                                    x-transition:leave-end="opacity-0 translate-y-1"
                                    class="absolute right-0 mt-2 w-64 bg-white shadow-lg rounded-md p-2 z-50"
                                >
                                    <form action="#!">
                                        <input
                                            id="search-query"
                                            name="s"
                                            type="search"
                                            placeholder="Search..."
                                            autocomplete="off"
                                            class="border border-gray-300 px-4 py-2.5 w-full text-sm focus:outline-none focus:border-dark"
                                        />
                                    </form>
                                </div>
                            </li>
                        </ul>
                    </div>

                    <!-- Mobile menu -->
                    <div
                        x-show="mobileOpen"
                        x-transition:enter="transition ease-out duration-200"
                        x-transition:enter-start="opacity-0 -translate-y-2"
                        x-transition:enter-end="opacity-100 translate-y-0"
                        x-transition:leave="transition ease-in duration-150"
                        x-transition:leave-start="opacity-100 translate-y-0"
                        x-transition:leave-end="opacity-0 -translate-y-2"
                        class="absolute top-full left-0 right-0 bg-white border-b border-gray-100 shadow-lg lg:hidden z-50"
                    >
                        <div class="max-w-6xl mx-auto px-4 py-4">
                            <ul class="flex flex-col gap-3">
                                <li>
                                    <a class="block py-2 text-sm font-medium capitalize hover:text-primary" href={`${base}`}>Home</a>
                                </li>
                                <li>
                                    <a class="block py-2 text-sm font-medium capitalize hover:text-primary" href={`${base}notes`}>Blogs</a>
                                </li>
                                <li>
                                    <a class="block py-2 text-sm font-medium capitalize hover:text-primary" href={`${base}projects`}>Projects</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </nav>
            </div>
        </header>

        <main>
            <slot />
        </main>

        <footer class="bg-dark mt-16">
            <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
                <div class="flex justify-center">
                    <div class="w-full lg:w-10/12 text-center">
                        <a class="inline-block mb-4 pb-2" href={`${base}`}>
                            <img
                                loading="prelaod"
                                decoding="async"
                                class="h-auto"
                                src={`${base}images/logo-white.png`}
                                alt="Reporter Hugo"
                            />
                        </a>
                        <ul class="flex justify-center gap-6 p-0 m-0 list-none">
                            <li>
                                <a class="text-white text-sm font-medium hover:text-primary hover:underline transition" href={`${base}notes`}>Blogs</a>
                            </li>
                            <li>
                                <a class="text-white text-sm font-medium hover:text-primary hover:underline transition" href={`${base}projects`}>Projects</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </footer>

    </body>
</html>
