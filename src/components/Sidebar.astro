---
const base = import.meta.env.BASE_URL;
---

<div class="bg-white panel p-6">
  <img loading="lazy" decoding="async" src={`${base}images/sonic.jpg`} alt="About Me" class="w-full mb-4" />
  <h3 class="text-lg font-bold text-gray-900 mb-2">Oleg Ushakov</h3>
  <p class="text-sm text-gray-500 mb-3 flex items-center gap-2">
    <i class="fa-solid fa-location-dot text-primary"></i>
    Kraków, Poland
  </p>
  <a href="https://github.com/OlegUshakov-pl" target="_blank" rel="noopener" class="flex items-center gap-3 text-sm text-gray-700 hover:text-primary transition-colors mb-4">
    <i class="fa-brands fa-github text-lg flex-shrink-0"></i>
    GitHub
  </a>
  <p class="text-gray-600 text-sm mb-4"></p>
  <div class="space-y-3 mb-4">
    <a href="https://x.com/Olek123zip" target="_blank" rel="noopener" class="flex items-center gap-3 text-sm text-gray-700 hover:text-primary transition-colors">
      <i class="fa-brands fa-x-twitter text-lg flex-shrink-0"></i>
      @Olek123zip
    </a>
    <a href="https://threads.net/@olek_tam" target="_blank" rel="noopener" class="flex items-center gap-3 text-sm text-gray-700 hover:text-primary transition-colors">
      <i class="fa-brands fa-threads text-lg flex-shrink-0"></i>
      @olek_tam
    </a>
    <a href="https://www.linkedin.com/in/oleg-ushakov-29212829/" target="_blank" rel="noopener" class="flex items-center gap-3 text-sm text-gray-700 hover:text-primary transition-colors">
      <i class="fa-brands fa-linkedin-in text-lg flex-shrink-0"></i>
      LinkedIn
    </a>
  </div>
</div>

<div class="bg-white panel p-6">
  <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
    <i class="fa-solid fa-images" style="color: #f74f4f"></i>
    Gallery
  </h3>
  <div class="space-y-3">
    <a href="/pdf/gallery-1.pdf" target="_blank" rel="noopener" class="flex items-center gap-3 text-sm text-gray-700 hover:text-primary transition-colors">
      <i class="fa-regular fa-file-pdf" style="color: #f74f4f"></i>
      Gallery 1
    </a>
    <a href="/pdf/gallery-2.pdf" target="_blank" rel="noopener" class="flex items-center gap-3 text-sm text-gray-700 hover:text-primary transition-colors">
      <i class="fa-regular fa-file-pdf" style="color: #f74f4f"></i>
      Gallery 2
    </a>
    <a href="/pdf/gallery-3.pdf" target="_blank" rel="noopener" class="flex items-center gap-3 text-sm text-gray-700 hover:text-primary transition-colors">
      <i class="fa-regular fa-file-pdf" style="color: #f74f4f"></i>
      Gallery 3
    </a>
    <a href="/pdf/gallery-4.pdf" target="_blank" rel="noopener" class="flex items-center gap-3 text-sm text-gray-700 hover:text-primary transition-colors">
      <i class="fa-regular fa-file-pdf" style="color: #f74f4f"></i>
      Gallery 4
    </a>
  </div>
</div>
