---
interface Props {
  title: string;
  description?: string;
  date: string;
  image?: string;
  tags?: string[];
  slug: string;
  readTime?: string;
}

const { title, description, date, image, tags, slug, readTime = '3 minutes read' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<article class="bg-white p-6 shadow-[0_5px_25px_rgba(0,0,0,0.05)]">
  <a href={`${base}notes/${slug}`}>
    <div class="relative">
      <div class="absolute right-0 top-0 pt-5 pl-5 pr-5">
        <span class="inline-block text-xs uppercase leading-tight py-1 px-2 bg-black/60 backdrop-blur-sm text-white mb-1">{date}</span>
        <span class="inline-block text-xs uppercase leading-tight py-1 px-2 bg-black/60 backdrop-blur-sm text-white">{readTime}</span>
      </div>
      <img loading="lazy" decoding="async" src={image || `${base}images/post/post-1.jpg`} alt="Post Thumbnail" class="w-full">
    </div>
  </a>
  <div class="px-0 pb-1">
    {tags && tags.length > 0 && (
      <ul class="flex flex-wrap gap-0 mb-2 p-0 list-none">
        {tags.map(tag => (
          <li>
            <a href={`${base}notes?tag=${tag}`} class="inline-block bg-gray-100 text-black capitalize py-0.5 px-2 mb-2 mr-0.5 text-sm hover:bg-primary/25 transition">{tag}</a>
          </li>
        ))}
      </ul>
    )}
    <h2 class="text-3xl font-bold"><a class="post-title" href={`${base}notes/${slug}`}>{title}</a></h2>
    {description && <p class="text-gray-600 mt-2">{description}</p>}
    <div class="content"><a class="read-more-btn" href={`${base}notes/${slug}`}>Read Full Article</a></div>
  </div>
</article>
