---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Projects - Reporter Blog">
  <section class="py-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col lg:flex-row gap-8">

        <!-- Sidebar + Categories — слева -->
        <div class="w-full lg:w-1/3">
          <Sidebar />
          <div class="mt-8">
            <h2 class="text-xl font-bold mb-3">Categories</h2>
            <div class="bg-white p-6 shadow-[0_5px_25px_rgba(0,0,0,0.05)]">
              <ul class="list-none p-0 m-0">
                <li><a href="#!" class="flex justify-between items-center bg-gray-100 text-black capitalize py-1.5 px-4 mb-2.5 text-sm hover:bg-primary/25 transition">engineering<span class="ml-auto">(1)</span></a></li>
                <li><a href="#!" class="flex justify-between items-center bg-gray-100 text-black capitalize py-1.5 px-4 mb-2.5 text-sm hover:bg-primary/25 transition">design<span class="ml-auto">(1)</span></a></li>
              </ul>
            </div>
          </div>
        </div>

        <!-- About me + Projects — справа -->
        <div class="w-full lg:w-2/3 mb-12 lg:mb-0">
          <h2 class="text-xl font-bold mb-3">About me</h2>
          <p class="mb-4">
            Mechanical design engineer with 20+ years professional experience with a
            solid background in machine design, tools, fixtures, dies, special machinery.
            Providing technology of manufacturing mechanical parts.
          </p>
          <h2 class="text-xl font-bold mb-3">Projects</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {projects.map((project, index) => (
              <div class={index === 0 ? 'col-span-full' : ''}>
                <PostCard
                  title={project.data.title}
                  description={project.data.description}
                  date={project.data.pubDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' })}
                  image={project.data.heroImage}
                  tags={project.data.tags}
                  slug={project.id}
                />
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
