---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import Recommended from '../components/Recommended.astro';
import { getCollection } from 'astro:content';

const allLinks = (await getCollection('links'))
  .filter(link => !link.data.draft);

const base = import.meta.env.BASE_URL;
const currentTag = Astro.url.searchParams.get('tag');

const links = currentTag
  ? allLinks.filter(link => link.data.tags?.includes(currentTag))
  : allLinks;

const allTags = [...new Set(allLinks.flatMap(link => link.data.tags || []))].sort();

const latestProjects = (await getCollection('projects'))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const latestPosts = (await getCollection('posts'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Links - Oleg Ushakov">
  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-1">
          <div class="space-y-8">
            <Sidebar />
            <Recommended projects={latestProjects} posts={latestPosts} />
          </div>
        </div>
        <div class="lg:col-span-2">
          <div class="bg-white panel p-6 mb-6">
            <h1 class="text-2xl sm:text-2xl text-gray-900 mb-2 font-semibold">Links</h1>
            <p class="text-gray-700 leading-relaxed">
              Useful links and resources.
            </p>
          </div>

          {allTags.length > 0 && (
            <div class="mb-6">
              <div class="flex flex-wrap gap-2">
                <a
                  href={`${base}links`}
                  class={`inline-block px-3 py-1 text-sm rounded-full transition ${!currentTag ? 'bg-primary text-white' : 'bg-sidebar text-muted hover:bg-primary hover:text-white'}`}
                >
                  All
                </a>
                {allTags.map(tag => (
                  <a
                    href={`${base}links?tag=${tag}`}
                    class={`inline-block px-3 py-1 text-sm rounded-full transition ${currentTag === tag ? 'bg-primary text-white' : 'bg-sidebar text-muted hover:bg-primary hover:text-white'}`}
                  >
                    {tag}
                  </a>
                ))}
              </div>
            </div>
          )}

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {links.map((link) => (
              <a
                href={link.data.url}
                target="_blank"
                rel="noopener"
                class="bg-white panel p-5 flex items-center gap-4 hover:shadow-md transition-shadow group"
              >
                {link.data.icon && (
                  <i class={`${link.data.icon} text-2xl text-primary group-hover:scale-110 transition-transform`}></i>
                )}
                <div class="min-w-0">
                  <h3 class="text-base font-bold text-gray-900 group-hover:text-primary transition-colors truncate">{link.data.title}</h3>
                  {link.data.description && (
                    <p class="text-gray-500 text-sm mt-1 line-clamp-2">{link.data.description}</p>
                  )}
                  {link.data.tags && link.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-1.5 mt-2">
                      {link.data.tags.map(tag => (
                        <span class="inline-block bg-sidebar text-muted text-xs px-2 py-0.5 rounded-full">{tag}</span>
                      ))}
                    </div>
                  )}
                </div>
              </a>
            ))}
          </div>

          {links.length === 0 && (
            <div class="bg-white panel p-6 text-center">
              <p class="text-gray-500">No links found{currentTag ? ` for tag "${currentTag}"` : ''}.</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
