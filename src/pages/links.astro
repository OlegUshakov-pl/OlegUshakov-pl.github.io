---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import Recommended from '../components/Recommended.astro';
import { getCollection } from 'astro:content';

const allLinks = (await getCollection('links'))
  .filter(link => !link.data.draft);

const allTagsEntries = await getCollection('tags');
const tagNameMap = new Map(allTagsEntries.map(t => [t.id, t.data.name]));

const base = import.meta.env.BASE_URL;

const linksData = allLinks.map(link => ({
  title: link.data.title,
  url: link.data.url,
  description: link.data.description || '',
  icon: link.data.icon || '',
  tags: link.data.tags || [],
}));

const allTagSlugs = [...new Set(allLinks.flatMap(link => link.data.tags || []))].sort();
const allTags = allTagSlugs.map(slug => ({ slug, name: tagNameMap.get(slug) || slug }));
const tagNameMapObj = Object.fromEntries(allTagsEntries.map(t => [t.id, t.data.name]));

const pageData = { linksData, allTags, tagNameMapObj };

const latestProjects = (await getCollection('projects'))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const latestPosts = (await getCollection('posts'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Links - Oleg Ushakov">
  <section class="py-12" x-data="linkFilter()">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-1">
          <div class="space-y-8">
            <Sidebar />
            <Recommended projects={latestProjects} posts={latestPosts} />
          </div>
        </div>
        <div class="lg:col-span-2">
          <div class="bg-white panel p-6 mb-6">
            <h1 class="text-2xl sm:text-2xl text-gray-900 mb-2 font-semibold">Links</h1>
            <p class="text-gray-700 leading-relaxed">
              Useful links and resources.
            </p>
          </div>

          {allTags.length > 0 && (
            <div class="mb-6">
              <div class="flex flex-wrap gap-2">
                <a
                  href={`${base}links`}
                  :class="activeTag === null ? 'bg-primary text-white' : 'bg-sidebar text-muted hover:bg-primary hover:text-white'"
                  class="inline-block px-3 py-1 text-sm rounded-full transition"
                >
                  All
                </a>
                {allTags.map(({ slug, name }) => (
                  <a
                    href={`${base}links?tag=${slug}`}
                    :class={`activeTag === '${slug}' ? 'bg-primary text-white' : 'bg-sidebar text-muted hover:bg-primary hover:text-white'`}
                    class="inline-block px-3 py-1 text-sm rounded-full transition"
                  >
                    {name}
                  </a>
                ))}
              </div>
            </div>
          )}

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <template x-for="(link, index) in filteredLinks" :key="index">
              <a
                :href="link.url"
                target="_blank"
                rel="noopener"
                class="bg-white panel p-5 flex items-center gap-4 hover:shadow-md transition-shadow group"
              >
                <i x-show="link.icon" :class="link.icon" class="text-2xl text-primary group-hover:scale-110 transition-transform"></i>
                <div class="min-w-0">
                  <h3 class="text-base font-bold text-gray-900 group-hover:text-primary transition-colors truncate" x-text="link.title"></h3>
                  <p x-show="link.description" x-text="link.description" class="text-gray-500 text-sm mt-1 line-clamp-2"></p>
                  <div x-show="link.tags.length > 0" class="flex flex-wrap gap-1.5 mt-2">
                    <template x-for="tag in link.tags" :key="tag">
                      <span class="inline-block bg-sidebar text-muted text-xs px-2 py-0.5 rounded-full" x-text="tagNameMap[tag] || tag"></span>
                    </template>
                  </div>
                </div>
              </a>
            </template>
          </div>

          <div x-show="filteredLinks.length === 0" class="bg-white panel p-6 text-center">
            <p class="text-gray-500">No links found<span x-show="activeTag"> for tag "<span x-text="activeTag"></span>"</span>.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ pageData }}>
    document.addEventListener('alpine:init', () => {
      Alpine.data('linkFilter', () => ({
        links: pageData.linksData,
        tagNameMap: pageData.tagNameMapObj,
        activeTag: null,
        get filteredLinks() {
          if (!this.activeTag) return this.links;
          return this.links.filter(link => link.tags.includes(this.activeTag));
        },
        init() {
          const params = new URLSearchParams(window.location.search);
          this.activeTag = params.get('tag');
        }
      }));
    });
  </script>
</BaseLayout>
