---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Oleg Ushakov - Blog">
  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-1">
          <div class="space-y-8">
            <Sidebar />
          </div>
        </div>
        <div class="lg:col-span-2">
          <div class="bg-white panel p-6 mb-6">
            <h1 class="text-2xl sm:text-2xl text-gray-900 mb-2 font-semibold">Hey there 👋</h1>
            <h2 class="text-3xl sm:text-3xl font-semibold mb-2">I'm Oleg Ushakov</h2>
            <p class="text-2xl sm:text-2xl text-gray-900 mb-2 flex items-center gap-2 font-medium">
              Mechanical design engineer / Developer
            </p>
            <p class="text-sm sm:text-lg text-gray-900 mb-3 flex items-center gap-2 font-semibold">
              <i class="fa-solid fa-location-dot text-primary"></i>
              Kraków, Poland
            </p>
            <p class="text-gray-700 leading-relaxed">
              Mechanical design engineer with 22+ years professional experience with a solid background in machine design,
              tools, fixtures, dies, special machinery. Providing technology of manufacturing mechanical parts.
              Calculations of mechanical parts, FEA analysis. Detailed manufacturing drawings and general bill of
              materials.
            </p>
          </div>

          <div class="bg-white panel p-6 mb-6">
            <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
              <i class="fa-solid fa-bolt text-primary text-lg"></i>
              Skills
            </h3>
            <div class="flex flex-wrap gap-2">
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">AutoCAD</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">SOLID EDGE</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">SolidWorks</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">Autodesk Inventor</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">Mechanical engineering</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">Technologies of manufacturing</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">MathCad</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">GD&T</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">CAM</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">Microsoft Office</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">Driver's license</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">Materials</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">IronCad</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">ZW3D</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">CNC</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">HTML</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">CSS</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">JavaScript</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">PHP</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">SQL</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">Python</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">Django</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">Linux</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">Git</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">Bash</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">Docker</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">Photoshop</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">CorelDRAW</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">3D printing</span>
              <span class="rounded-full bg-sidebar px-3 py-1 text-sm text-muted">3D modeling</span>
            </div>
          </div>

          <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2">
            <i class="fa-solid fa-newspaper text-primary text-xl"></i>
            Projects
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {projects.map((project) => (
              <article class="bg-white panel overflow-hidden group hover:shadow-md transition-shadow">
                <a href={`${base}projects/${project.id}`}>
                  <div class="relative overflow-hidden">
                    {project.data.heroImage && (
                      <img loading="lazy" decoding="async" src={project.data.heroImage} alt="Project Thumbnail" class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300" />
                    )}
                    <div class="absolute top-3 left-3 flex gap-2">
                      <span class="bg-primary text-white text-xs font-semibold px-2.5 py-1">{project.data.pubDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
                    </div>
                  </div>
                </a>
                <div class="p-5">
                  <h3 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-primary transition-colors">
                    <a href={`${base}projects/${project.id}`}>{project.data.title}</a>
                  </h3>
                  <p class="text-gray-600 text-sm mb-4 line-clamp-2">{project.data.description}</p>
                  <div class="flex items-center justify-between">
                    <a href={`${base}projects/${project.id}`} class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:text-primary-dark transition-colors">
                      View Project
                      <i class="fa-solid fa-arrow-right"></i>
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>