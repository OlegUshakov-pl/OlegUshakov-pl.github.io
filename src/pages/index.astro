---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';

const posts = [
  {
    title: 'Is it Ethical to Travel Now? With that Freedom Comes Responsibility.',
    description: 'Heading Here is example of hedings. You can use this heading by following markdownify rules.',
    date: '04 Jun 2021',
    image: 'images/post/post-1.jpg',
    tags: ['travel', 'news'],
    slug: 'is-it-ethical-to-travel-now',
    readTime: '3 minutes read'
  },
  {
    title: 'An Experiential Guide to Explore This Kingdom',
    description: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna …',
    date: '03 Jun 2021',
    image: 'images/post/post-2.jpg',
    tags: ['travel'],
    slug: 'experiential-guide-explore-kingdom',
    readTime: '2 minutes read'
  },
];
---

<BaseLayout title="Reporter - HTML Blog Template">
  <section class="section">
    <div class="container">
      <div class="row no-gutters-lg">

        <!-- Sidebar + Categories — слева -->
        <div class="col-lg-4">
          <Sidebar />
          <div class="widget">
            <h2 class="section-title mb-3">Categories</h2>
            <div class="widget-body">
              <ul class="widget-list">
                <li><a href="#!">computer<span class="ml-auto">(3)</span></a></li>
                <li><a href="#!">cruises<span class="ml-auto">(2)</span></a></li>
                <li><a href="#!">destination<span class="ml-auto">(1)</span></a></li>
                <li><a href="#!">lifestyle<span class="ml-auto">(2)</span></a></li>
                <li><a href="#!">news<span class="ml-auto">(5)</span></a></li>
                <li><a href="#!">tips<span class="ml-auto">(1)</span></a></li>
                <li><a href="#!">travel<span class="ml-auto">(3)</span></a></li>
              </ul>
            </div>
          </div>
        </div>

        <!-- About me + Articles — справа -->
        <div class="col-lg-8 mb-5 mb-lg-0">
          <h2 class="section-title">About me</h2>
          <p class="mb-4">
            Mechanical design engineer with 20+ years professional experience with a
            solid background in machine design, tools, fixtures, dies, special machinery.
            Providing technology of manufacturing mechanical parts.
          </p>
          <h2 class="section-title">Latest Articles</h2>
          <div class="row">
            {posts.map((post, index) => (
              <div class={index === 0 ? 'col-12 mb-4' : 'col-md-6 mb-4'}>
                <PostCard
                  title={post.title}
                  description={post.description}
                  date={post.date}
                  image={post.image}
                  tags={post.tags}
                  slug={post.slug}
                  readTime={post.readTime}
                />
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
