---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const posts = (await getCollection('posts'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Notes - Reporter Blog">
  <section class="section">
    <div class="container">
      <div class="row no-gutters-lg">
        <div class="col-12">
          <h2 class="section-title">Latest Articles</h2>
        </div>

        <!-- Categories — слева -->
        <div class="col-lg-4">
          <div class="widget">
            <h2 class="section-title mb-3">Categories</h2>
            <div class="widget-body">
              <ul class="widget-list">
                <li><a href="#!">computer<span class="ml-auto">(3)</span></a></li>
                <li><a href="#!">cruises<span class="ml-auto">(2)</span></a></li>
                <li><a href="#!">destination<span class="ml-auto">(1)</span></a></li>
                <li><a href="#!">lifestyle<span class="ml-auto">(2)</span></a></li>
                <li><a href="#!">news<span class="ml-auto">(5)</span></a></li>
                <li><a href="#!">tips<span class="ml-auto">(1)</span></a></li>
                <li><a href="#!">travel<span class="ml-auto">(3)</span></a></li>
              </ul>
            </div>
          </div>
        </div>

        <!-- About Me + Articles — справа -->
        <div class="col-lg-8 mb-5 mb-lg-0">
          <!-- About Me -->
          <div class="widget mb-4">
            <div class="widget-body">
              <img
                loading="lazy"
                decoding="async"
                src={`${base}images/sonic.jpg`}
                alt="About Me"
                class="w-100 author-thumb-sm d-block"
              />
              <h2 class="widget-title my-3">Oleg Ushakov</h2>
              <p class="mb-3 pb-2">Mechanical design engineer / Developer</p>
              <p><a href="https://x.com/Olek123zip">@Olek123zip</a></p>
              <p><a href="https://x.com/olek_tam">@olek_tam</a></p>
              <p><a href="https://www.linkedin.com/in/oleg-ushakov-29212829/">Linkedin</a></p>
              <a href={`${base}about`} class="btn btn-sm btn-outline-primary">Know More</a>
            </div>
          </div>

          <!-- Articles -->
          <div class="row">
            {posts.map((post, index) => (
              <div class={index === 0 ? 'col-12 mb-4' : 'col-md-6 mb-4'}>
                <PostCard
                  title={post.data.title}
                  description={post.data.description}
                  date={post.data.pubDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' })}
                  image={post.data.heroImage}
                  tags={post.data.tags}
                  slug={post.id}
                />
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
