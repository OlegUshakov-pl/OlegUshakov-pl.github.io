---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Notes - Reporter Blog">
  <section class="section">
    <div class="container">
      <div class="row no-gutters-lg">

        <!-- Sidebar + Categories — слева -->
        <div class="col-lg-4">
          <Sidebar />
          <div class="widget">
            <h2 class="section-title mb-3">Categories</h2>
            <div class="widget-body">
              <ul class="widget-list">
                <li><a href="#!">computer<span class="ml-auto">(3)</span></a></li>
                <li><a href="#!">cruises<span class="ml-auto">(2)</span></a></li>
                <li><a href="#!">destination<span class="ml-auto">(1)</span></a></li>
                <li><a href="#!">lifestyle<span class="ml-auto">(2)</span></a></li>
                <li><a href="#!">news<span class="ml-auto">(5)</span></a></li>
                <li><a href="#!">tips<span class="ml-auto">(1)</span></a></li>
                <li><a href="#!">travel<span class="ml-auto">(3)</span></a></li>
              </ul>
            </div>
          </div>
        </div>

        <!-- About me + Articles — справа -->
        <div class="col-lg-8 mb-5 mb-lg-0">
          <h2 class="section-title">About me</h2>
          <p class="mb-4">
            Mechanical design engineer with 20+ years professional experience with a
            solid background in machine design, tools, fixtures, dies, special machinery.
            Providing technology of manufacturing mechanical parts.
          </p>
          <h2 class="section-title">Latest Articles</h2>
          <div class="row">
            {posts.map((post, index) => (
              <div class={index === 0 ? 'col-12 mb-4' : 'col-md-6 mb-4'}>
                <PostCard
                  title={post.data.title}
                  description={post.data.description}
                  date={post.data.pubDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' })}
                  image={post.data.heroImage}
                  tags={post.data.tags}
                  slug={post.id}
                />
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
