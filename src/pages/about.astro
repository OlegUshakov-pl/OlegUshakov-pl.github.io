---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About - Reporter Blog">
  <section class="py-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex">
        <div class="w-full lg:w-2/3">
          <h1 class="text-4xl font-bold mb-4">About Me</h1>
          <div class="content">
            <p>Hello, I'm a content writer, developer and story teller. Welcome to my blog where I share my thoughts and experiences.</p>
            <p>This blog is built with Astro and uses the Reporter Bootstrap theme.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
