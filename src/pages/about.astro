---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About - Reporter Blog">
  <section class="section">
    <div class="container">
      <div class="row">
        <div class="col-lg-8">
          <h1 class="mb-4">About Me</h1>
          <div class="content">
            <p>Hello, I'm a content writer, developer and story teller. Welcome to my blog where I share my thoughts and experiences.</p>
            <p>This blog is built with Astro and uses the Reporter Bootstrap theme.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
