---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import Recommended from '../../components/Recommended.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const projects = await getCollection('projects');
  const links = await getCollection('links');

  const allTags = new Set<string>();

  posts.forEach(post => {
    if (!post.data.draft) post.data.tags?.forEach(t => allTags.add(t));
  });
  projects.forEach(project => {
    if (!project.data.draft) project.data.tags?.forEach(t => allTags.add(t));
  });
  links.forEach(link => {
    if (!link.data.draft) link.data.tags?.forEach(t => allTags.add(t));
  });

  return [...allTags].map(tag => ({
    params: { slug: tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const base = import.meta.env.BASE_URL;

const posts = (await getCollection('posts'))
  .filter(p => !p.data.draft && p.data.tags?.includes(tag))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const projects = (await getCollection('projects'))
  .filter(p => !p.data.draft && p.data.tags?.includes(tag))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const links = (await getCollection('links'))
  .filter(l => !l.data.draft && l.data.tags?.includes(tag));

const latestProjects = (await getCollection('projects'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const latestPosts = (await getCollection('posts'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const hasResults = posts.length > 0 || projects.length > 0 || links.length > 0;
---

<BaseLayout title={`#${tag} - Oleg Ushakov`}>
  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-1">
          <div class="space-y-8">
            <Sidebar />
            <Recommended projects={latestProjects} posts={latestPosts} />
          </div>
        </div>
        <div class="lg:col-span-2">
          <div class="bg-white panel p-6 mb-6">
            <h1 class="text-2xl sm:text-2xl text-gray-900 mb-2 font-semibold">
              <i class="fa-solid fa-tag text-primary"></i> #{tag}
            </h1>
            <p class="text-gray-700 leading-relaxed">
              All content tagged with "{tag}".
            </p>
          </div>

          {!hasResults && (
            <div class="bg-white panel p-6 text-center">
              <p class="text-gray-500">No content found for this tag.</p>
            </div>
          )}

          {posts.length > 0 && (
            <div class="mb-8">
              <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
                <i class="fa-solid fa-pen-nib text-primary"></i>
                Blogs ({posts.length})
              </h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                {posts.map((post) => (
                  <article class="bg-white panel overflow-hidden group hover:shadow-md transition-shadow">
                    <a href={`${base}blogs/${post.id}`}>
                      <div class="relative overflow-hidden">
                        {post.data.heroImage && (
                          <img loading="lazy" decoding="async" src={post.data.heroImage} alt="Post Thumbnail" class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300" />
                        )}
                        <div class="absolute top-3 left-3 flex gap-2">
                          <span class="bg-primary text-white text-xs font-semibold px-2.5 py-1">{post.data.pubDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
                        </div>
                      </div>
                    </a>
                    <div class="p-5">
                      <h3 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-primary transition-colors">
                        <a href={`${base}blogs/${post.id}`}>{post.data.title}</a>
                      </h3>
                      <p class="text-gray-600 text-sm mb-4 line-clamp-2">{post.data.description}</p>
                      {post.data.tags && post.data.tags.length > 0 && (
                        <div class="flex flex-wrap gap-1.5 mb-3">
                          {post.data.tags.map(t => (
                            <a href={`${base}tags/${t}`} class="inline-block bg-sidebar text-muted text-xs px-2 py-0.5 rounded-full hover:bg-primary hover:text-white transition">{t}</a>
                          ))}
                        </div>
                      )}
                      <a href={`${base}blogs/${post.id}`} class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:text-primary-dark transition-colors">
                        Read More
                        <i class="fa-solid fa-arrow-right"></i>
                      </a>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          )}

          {projects.length > 0 && (
            <div class="mb-8">
              <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
                <i class="fa-solid fa-newspaper text-primary"></i>
                Projects ({projects.length})
              </h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                {projects.map((project) => (
                  <article class="bg-white panel overflow-hidden group hover:shadow-md transition-shadow">
                    <a href={`${base}projects/${project.id}`}>
                      <div class="relative overflow-hidden">
                        {project.data.heroImage && (
                          <img loading="lazy" decoding="async" src={project.data.heroImage} alt="Project Thumbnail" class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300" />
                        )}
                        <div class="absolute top-3 left-3 flex gap-2">
                          <span class="bg-primary text-white text-xs font-semibold px-2.5 py-1">{project.data.pubDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
                        </div>
                      </div>
                    </a>
                    <div class="p-5">
                      <h3 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-primary transition-colors">
                        <a href={`${base}projects/${project.id}`}>{project.data.title}</a>
                      </h3>
                      <p class="text-gray-600 text-sm mb-4 line-clamp-2">{project.data.description}</p>
                      {project.data.tags && project.data.tags.length > 0 && (
                        <div class="flex flex-wrap gap-1.5 mb-3">
                          {project.data.tags.map(t => (
                            <a href={`${base}tags/${t}`} class="inline-block bg-sidebar text-muted text-xs px-2 py-0.5 rounded-full hover:bg-primary hover:text-white transition">{t}</a>
                          ))}
                        </div>
                      )}
                      <a href={`${base}projects/${project.id}`} class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:text-primary-dark transition-colors">
                        View Project
                        <i class="fa-solid fa-arrow-right"></i>
                      </a>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          )}

          {links.length > 0 && (
            <div class="mb-8">
              <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
                <i class="fa-solid fa-link text-primary"></i>
                Links ({links.length})
              </h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {links.map((link) => (
                  <a
                    href={link.data.url}
                    target="_blank"
                    rel="noopener"
                    class="bg-white panel p-5 flex items-center gap-4 hover:shadow-md transition-shadow group"
                  >
                    {link.data.icon && (
                      <i class={`${link.data.icon} text-2xl text-primary group-hover:scale-110 transition-transform`}></i>
                    )}
                    <div class="min-w-0">
                      <h3 class="text-base font-bold text-gray-900 group-hover:text-primary transition-colors truncate">{link.data.title}</h3>
                      {link.data.description && (
                        <p class="text-gray-500 text-sm mt-1 line-clamp-2">{link.data.description}</p>
                      )}
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
