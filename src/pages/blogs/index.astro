---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import Recommended from '../../components/Recommended.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('posts'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTagsEntries = await getCollection('tags');
const tagNameMap = new Map(allTagsEntries.map(t => [t.id, t.data.name]));

const base = import.meta.env.BASE_URL;
const currentTag = Astro.url.searchParams.get('tag');

const posts = currentTag
  ? allPosts.filter(post => post.data.tags?.includes(currentTag))
  : allPosts;

const allTagSlugs = [...new Set(allPosts.flatMap(post => post.data.tags || []))].sort();
const allTags = allTagSlugs.map(slug => ({ slug, name: tagNameMap.get(slug) || slug }));

const latestProjects = (await getCollection('projects'))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const latestPosts = allPosts.slice(0, 3);
---

<BaseLayout title="Blogs - Oleg Ushakov">
  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-1">
          <div class="space-y-8">
            <Sidebar />
            <Recommended projects={latestProjects} posts={latestPosts} />
          </div>
        </div>
        <div class="lg:col-span-2">
          <div class="bg-white panel p-6 mb-6">
            <h1 class="text-2xl sm:text-2xl text-gray-900 mb-2 font-semibold">Blogs</h1>
            <p class="text-gray-700 leading-relaxed">
              Here you can find my blog posts and articles.
            </p>
          </div>

          {allTags.length > 0 && (
            <div class="mb-6">
              <div class="flex flex-wrap gap-2">
                <a
                  href={`${base}blogs`}
                  class={`inline-block px-3 py-1 text-sm rounded-full transition ${!currentTag ? 'bg-primary text-white' : 'bg-sidebar text-muted hover:bg-primary hover:text-white'}`}
                >
                  All
                </a>
                {allTags.map(({ slug, name }) => (
                  <a
                    href={`${base}tags/${slug}`}
                    class={`inline-block px-3 py-1 text-sm rounded-full transition ${currentTag === slug ? 'bg-primary text-white' : 'bg-sidebar text-muted hover:bg-primary hover:text-white'}`}
                  >
                    {name}
                  </a>
                ))}
              </div>
            </div>
          )}

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {posts.map((post) => (
              <article class="bg-white panel overflow-hidden group hover:shadow-md transition-shadow">
                <a href={`${base}blogs/${post.id}`}>
                  <div class="relative overflow-hidden">
                    {post.data.heroImage && (
                      <img loading="lazy" decoding="async" src={post.data.heroImage} alt="Post Thumbnail" class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300" />
                    )}
                    <div class="absolute top-3 left-3 flex gap-2">
                      <span class="bg-primary text-white text-xs font-semibold px-2.5 py-1">{post.data.pubDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
                    </div>
                  </div>
                </a>
                <div class="p-5">
                  <h3 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-primary transition-colors">
                    <a href={`${base}blogs/${post.id}`}>{post.data.title}</a>
                  </h3>
                  <p class="text-gray-600 text-sm mb-4 line-clamp-2">{post.data.description}</p>
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-1.5 mb-3">
                      {post.data.tags.map(tag => (
                        <a href={`${base}tags/${tag}`} class="inline-block bg-sidebar text-muted text-xs px-2 py-0.5 rounded-full hover:bg-primary hover:text-white transition">{tagNameMap.get(tag) || tag}</a>
                      ))}
                    </div>
                  )}
                  <a href={`${base}blogs/${post.id}`} class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:text-primary-dark transition-colors">
                    Read More
                    <i class="fa-solid fa-arrow-right"></i>
                  </a>
                </div>
              </article>
            ))}
          </div>

          {posts.length === 0 && (
            <div class="bg-white panel p-6 text-center">
              <p class="text-gray-500">No posts found{currentTag ? ` for tag "${currentTag}"` : ''}.</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
